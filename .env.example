APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=base_laravel_project
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,127.0.0.1::8081,localhost:8081

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# FILESYSTEM_DRIVER=Wasabi
# MEDIA_DISK=Wasabi

WAS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
WAS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WAS_DEFAULT_REGION=us-east-1
WAS_BUCKET=Bucket-Name
WAS_URL=s3.wasabisys.com

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1

# ==============================================
# FILESYSTEM LIMITS CONFIGURATION
# ==============================================
# Configuration for AI Models and Datasets file size limits
# Adjust these values based on your server capacity and storage limits

# ---------------------------------------------
# MODEL FILE LIMITS
# ---------------------------------------------
# Maximum size for individual files within a model ZIP (in bytes)
# Default: 2GB (2147483648 bytes)
MODEL_MAX_FILE_SIZE=2147483648
MODEL_MAX_FILE_SIZE_LABEL="2GB"

# Maximum total size for all extracted files in a model ZIP (in bytes)
# Default: 10GB (10737418240 bytes)
MODEL_MAX_TOTAL_SIZE=10737418240
MODEL_MAX_TOTAL_SIZE_LABEL="10GB"

# Maximum size for the ZIP file itself (in bytes)
# Default: 5GB (5368709120 bytes)
MODEL_MAX_ZIP_SIZE=5368709120
MODEL_MAX_ZIP_SIZE_LABEL="5GB"

# Maximum number of files allowed in a single model ZIP
# Default: 10000 files
MODEL_MAX_FILE_COUNT=10000

# ---------------------------------------------
# DATASET FILE LIMITS
# ---------------------------------------------
# Maximum size for individual files within a dataset ZIP (in bytes)
# Default: 1GB (1073741824 bytes)
DATASET_MAX_FILE_SIZE=1073741824
DATASET_MAX_FILE_SIZE_LABEL="1GB"

# Maximum total size for all extracted files in a dataset ZIP (in bytes)
# Default: 20GB (21474836480 bytes)
DATASET_MAX_TOTAL_SIZE=21474836480
DATASET_MAX_TOTAL_SIZE_LABEL="20GB"

# Maximum size for the dataset ZIP file itself (in bytes)
# Default: 8GB (8589934592 bytes)
DATASET_MAX_ZIP_SIZE=8589934592
DATASET_MAX_ZIP_SIZE_LABEL="8GB"

# Maximum number of files allowed in a single dataset ZIP
# Default: 50000 files
DATASET_MAX_FILE_COUNT=50000

# ---------------------------------------------
# PROCESSING LIMITS
# ---------------------------------------------
# Maximum time (in seconds) to spend extracting a ZIP file
# Default: 300 seconds (5 minutes)
MAX_EXTRACTION_TIME=300

# Maximum memory usage (in bytes) for ZIP processing
# Default: 512MB (536870912 bytes)
MAX_MEMORY_USAGE=536870912

# Enable/disable parallel file uploads to storage
# Default: true
ENABLE_PARALLEL_UPLOADS=true

# Number of files to process in parallel when uploading to storage
# Default: 5 concurrent uploads
PARALLEL_UPLOAD_LIMIT=5

# Rate Limiting Configuration
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10  
LOGIN_RATE_LIMIT_PER_MINUTE=5
